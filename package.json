{
	"name": "template-hono",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"seed": "tsx --env-file=.env src/prisma/seed.ts",
		"start": "node --env-file=.env dist/index.js",
		"worker:dev": "tsx watch --env-file=.env src/worker.ts",
		"worker:start": "node --env-file=.env dist/worker.js"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@prisma/orm-postgres": "8.0.0-rc.12",
		"@scalar/hono-api-reference": "^0.12.6",
		"@valibot/to-json-schema": "^1.8.0",
		"argon2": "^0.45.1",
		"cron": "^4.4.0",
		"dotenv": "^18.0.4",
		"hono": "^4.13.9",
		"hono-openapi": "^1.3.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@prisma/cli-engine": "0.6.1",
		"@types/node": "^26.6.3",
		"prisma": "8.0.0-rc.17",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.3.4",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
